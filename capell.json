    "contributionTraceability": { "deferredContributions": [] },
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": ["extension_cookbook_entries"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": ["sites"],
        "afterInstall": null,
        "afterInstallParams": ["sites"],
        "uninstall": null,
        "doctor": "capell:extension-cookbook-doctor"
    },
    "actions": {
        "install": "Capell\\ExtensionCookbook\\Actions\\InstallExtensionCookbookPackageAction",
        "setup": "Capell\\ExtensionCookbook\\Actions\\SetupExtensionCookbookPackageAction",
        "afterInstall": "Capell\\ExtensionCookbook\\Actions\\AfterInstallExtensionCookbookPackageAction",
        "uninstall": "Capell\\ExtensionCookbook\\Actions\\UninstallExtensionCookbookPackageAction"
    },
    "settings": [
        "Capell\\ExtensionCookbook\\Settings\\ExtensionCookbookSettings"
    ],
    "permissions": ["View:ExtensionCookbook", "Manage:ExtensionCookbook"],
    "capabilities": [
        "extension-cookbook",
        "developer-reference",
        "public-extension-contracts"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": ["capell-extension-cookbook.index"],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:ExtensionCookbook",
                "Manage:ExtensionCookbook"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 10,
        "adminQueryBudget": 20,
        "cacheTags": ["extension-cookbook"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "extension-cookbook.package-health",
            "label": "Capell Extension Cookbook package surfaces are discoverable.",
            "class": "Capell\\ExtensionCookbook\\Health\\ExtensionCookbookHealthCheck",
            "severity": "warning",
            "surface": "shared"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "A free developer reference for Capell's supported public extension contracts.",
        "categories": ["admin", "console", "foundation", "frontend"],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Capell Extension Cookbook developer reference package card",
                "caption": "Capell Extension Cookbook package reference"
            }
        ],
        "sales_pitch": "Capell Extension Cookbook is a free developer reference for the supported public extension contracts in Capell. It demonstrates package-owned models, typed Actions and data, lifecycle registration, settings, outbound events, blueprint subjects, metrics, and scoped page integration. The example stays deliberately small and safe so developers can trace registration before building a production package. Use it as a reference for public package surfaces, not as a replacement for your domain or private internals. Review the documentation and tests before adapting it."
    }
}
