            "migrationFiles": [
                "2026_08_29_000001_create_extension_cookbook_entries",
                "2026_08_29_000002_scope_extension_cookbook_entry_slugs"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\ExtensionCookbook\\Manifest\\Frontend\\ExtensionCookbookScheduledJobContribution",
