        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "A sample extension for developers with a coverage list, example records, a widget and a health check to read and copy from. Site owners can skip it.",
        "description": "Capell Extension Cookbook is a developer reference, not a feature for editors or visitors. It adds a coverage page under Developer that marks the main ways of plugging into Capell as Demonstrated or Deliberately inactive, a list of sample Reference entries, one sample page widget with a required title and summary, a sample health check and a doctor command. Permissions control who can view the page and who can change entries. Installing it also creates a public page at /extension-cookbook.",
        "problem": "Building a first extension is slow without a complete working example of how the pieces connect.",
        "outcome": "A developer sees what a working extension covers and copies from a small example that runs.",
        "faq": [
            {
                "question": "Does my site need Extension Cookbook?",
                "answer": "No. It's for developers building their first Capell package, who can read and copy from a small one that already works. A site owner gets nothing from it and can leave it out."
            },
            {
                "question": "What does it add to my admin and my website?",
                "answer": "In the Developer section of the admin it adds a coverage list and a list of made-up Reference entries. It also adds a public page at /extension-cookbook where any visitor sees the titles of the enabled entries."
            },
            {
                "question": "Should I remove it before the site goes live?",
                "answer": "Yes, if you only needed it for learning. Otherwise its public page stays on your website for anyone to open."
            },
            {
                "question": "What has to be installed before I can add it?",
                "answer": "The admin, the website and Layout Builder. It needs all three installed first."
            }
        ],
        "categories": ["admin", "console", "foundation", "frontend"],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Marketplace card with a cut-off title, two checklist panels labelled Find and Trace and a three-step diagram",
                "caption": "The card that represents Extension Cookbook on its Marketplace listing."
            }
        ],
        "sales_pitch": "Capell Extension Cookbook is a free developer reference for the supported public extension contracts in Capell. It demonstrates package-owned models, typed Actions and data, lifecycle registration, settings, outbound events, blueprint subjects, metrics, and scoped page integration. The example stays deliberately small and safe so developers can trace registration before building a production package. Use it as a reference for public package surfaces, not as a replacement for your domain or private internals. Review the documentation and tests before adapting it."
    }
