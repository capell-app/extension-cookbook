{
    "manifest-version": 3,
    "name": "capell-app/extension-cookbook",
    "slug": "extension-cookbook",
    "displayName": "Capell Extension Cookbook",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "A free first-party developer reference for Capell's supported public extension contracts.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\ExtensionCookbook",
    "surfaces": ["admin", "frontend", "shared"],
