        {
            "type": "frontend-component",
            "class": "Capell\\ExtensionCookbook\\Manifest\\Frontend\\ExtensionCookbookFrontendComponentContribution"
        },
        {
            "type": "content-widget",
            "class": "Capell\\ExtensionCookbook\\Manifest\\Frontend\\ExtensionCookbookContentWidgetContribution",
            "key": "capell-app.extension-cookbook"
        },
        {
            "type": "render-hook",
            "class": "Capell\\ExtensionCookbook\\Manifest\\Frontend\\ExtensionCookbookRenderHookContribution"
        },
        {
