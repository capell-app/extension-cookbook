{
    "name": "capell-app/extension-cookbook",
    "description": "A small sample Capell extension for developers, with a coverage list, example records, a widget and a health check to read and copy.",
    "homepage": "https://docs.capell.app/packages/extension-cookbook",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0.78",
        "capell-app/core": "^1.0.79",
        "capell-app/frontend": "^1.0.79",
        "capell-app/layout-builder": "^1.0",
        "filament/forms": "^5.7.6",
        "filament/filament": "^5.7.6",
        "laravel/framework": "^12.61.1|^13.12.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1",
        "spatie/laravel-settings": "^3.0"
    },
    "suggest": {
        "capell-app/content-sections": "Registers the Extension Cookbook example section when Content Sections is installed."
    },
    "autoload": {
        "psr-4": {
            "Capell\\ExtensionCookbook\\": "src/",
            "Capell\\ExtensionCookbook\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\ExtensionCookbook\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\ExtensionCookbook\\Providers\\ExtensionCookbookServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "support": {
        "source": "https://github.com/capell-app/extension-cookbook",
        "docs": "https://docs.capell.app/packages/extension-cookbook"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
